PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://admin:your-mongo-password@mongodb_health:27017/health_insurance?authSource=admin
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CLIENT_URL=http://localhost:3000

# Administrator account setup (for seed/createAdmin.js)
ADMIN_EMAIL=admin@insuremed.local
ADMIN_PASSWORD=your-secure-admin-password

# Google Gemini AI settings (required for AI chat, FAQ search, and RAG document embeddings)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
ATLAS_VECTOR_INDEX=vector_index

# Email service settings (required for verification, password reset, and SLA escalation alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@insuremed.local
